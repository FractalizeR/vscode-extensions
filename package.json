{
  "name": "vscode-extensions",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "prepare": "lefthook install",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "depcruise": "dependency-cruiser --config .dependency-cruiser.mjs packages/projects-tree/src packages/projects-tree/webview/src",
    "depcruise:negative": "node tools/depcruise-negative.ts",
    "knip": "knip",
    "test": "vitest run",
    "schema:check": "node packages/projects-tree/schemas/check-schema.mjs",
    "check": "pnpm run format:check && pnpm run typecheck && pnpm run lint && pnpm run depcruise && pnpm run depcruise:negative && pnpm run knip && pnpm run test && pnpm run l10n:check && pnpm run schema:check",
    "l10n:generate": "node tools/check-l10n.ts generate",
    "l10n:check": "node tools/check-l10n.ts check"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-security": "^4.2.1",
    "eslint-plugin-unicorn": "^79.0.0",
    "globals": "^17.14.0",
    "knip": "^6.44.2",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
